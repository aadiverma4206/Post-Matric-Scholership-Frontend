@model Scholarship.Web.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password / User ID";
    Layout = "_Layout";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="gov-card shadow">
            <div class="gov-card-header bg-primary text-white text-center py-3">
                <div class="d-flex justify-content-center mb-2">
                    <div class="gov-emblem-badge p-1" style="width: 60px; height: 60px;">
                        <img src="~/images/cg-emblem.png" alt="Emblem" class="img-fluid" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                </div>
                <h4 class="fw-bold mb-0">Reset Password</h4>
                <p class="small text-white-50 mb-0">Recover your Post Matric Scholarship Portal Account</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="UserName" class="form-control" placeholder="Enter your registered User ID" required />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MobileOrEmail" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-phone"></i></span>
                            <input asp-for="MobileOrEmail" class="form-control" placeholder="Enter registered Mobile Number or Email" required />
                        </div>
                        <span asp-validation-for="MobileOrEmail" class="text-danger small"></span>
                        <div class="form-text small text-muted">
                            A secure 6-digit one-time password (OTP) will be dispatched to this contact.
                        </div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary fw-bold py-2">
                            <i class="bi bi-send me-1"></i> Send Verification OTP
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center small pt-2 border-top">
                        <a asp-action="Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Back to Login
                        </a>
                        <a asp-action="ForgotUserId" class="text-decoration-none text-primary fw-semibold">
                            <i class="bi bi-person-badge me-1"></i> Forgot User ID?
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
