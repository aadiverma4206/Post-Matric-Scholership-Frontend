@model Scholarship.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Verify OTP & Set New Password";
    Layout = "_Layout";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="gov-card shadow">
            <div class="gov-card-header bg-success text-white text-center py-3">
                <div class="d-flex justify-content-center mb-2">
                    <div class="gov-emblem-badge p-1" style="width: 60px; height: 60px;">
                        <img src="~/images/cg-emblem.png" alt="Emblem" class="img-fluid" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                </div>
                <h4 class="fw-bold mb-0">Enter OTP &amp; New Password</h4>
                <p class="small text-white-50 mb-0">Complete verification to update your account password</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserName" />
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Resetting password for User ID: <strong>@Model.UserName</strong>
                    </div>

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="OtpCode" class="form-control text-center fs-5 fw-bold letter-spacing-2" maxlength="6" placeholder="6-digit OTP" required />
                        </div>
                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new strong password" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text small text-muted">Must have at least 8 characters with upper, lower, digit &amp; special symbol.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Re-type new password" required />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success fw-bold py-2">
                            <i class="bi bi-check2-circle me-1"></i> Update Password
                        </button>
                        <a asp-action="Login" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
