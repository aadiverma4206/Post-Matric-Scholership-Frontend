@{
    ViewData["Title"] = "Application Form Wizard";
    int currentStep = ViewBag.CurrentStep ?? 1;
    var profile = (Scholarship.Web.ViewModels.StudentProfileViewModel?)ViewBag.Profile;
    var addr = (Scholarship.Web.ViewModels.AddressViewModel?)ViewBag.Address;
    var acad = (Scholarship.Web.ViewModels.AcademicDetailsViewModel?)ViewBag.Academic;
    var bank = (Scholarship.Web.ViewModels.BankAccountViewModel?)ViewBag.Bank;
}

<div class="container my-3">
    <!-- Wizard Stepper Indicator -->
    <div class="wizard-steps no-print">
        <div class="wizard-step-item @(currentStep >= 1 ? (currentStep > 1 ? "completed" : "active") : "")">
            <div class="step-circle">1</div>
            <div class="small fw-bold">Personal &amp; Address</div>
        </div>
        <div class="wizard-step-item @(currentStep >= 2 ? (currentStep > 2 ? "completed" : "active") : "")">
            <div class="step-circle">2</div>
            <div class="small fw-bold">Current Course</div>
        </div>
        <div class="wizard-step-item @(currentStep >= 3 ? (currentStep > 3 ? "completed" : "active") : "")">
            <div class="step-circle">3</div>
            <div class="small fw-bold">Qualifications</div>
        </div>
        <div class="wizard-step-item @(currentStep >= 4 ? (currentStep > 4 ? "completed" : "active") : "")">
            <div class="step-circle">4</div>
            <div class="small fw-bold">Bank Details</div>
        </div>
        <div class="wizard-step-item @(currentStep >= 5 ? (currentStep > 5 ? "completed" : "active") : "")">
            <div class="step-circle">5</div>
            <div class="small fw-bold">Certificates</div>
        </div>
    </div>

    <form asp-action="SaveStep" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="step" value="@currentStep" />

        @if (currentStep == 1)
        {
            <!-- STEP 1: Personal & Addresses -->
            <div class="gov-form-section">
                <div class="gov-section-header">
                    <i class="bi bi-person-circle me-2"></i> Step 1: Personal, Household &amp; Address Details
                </div>
                <div class="gov-section-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Full Name</label>
                            <input class="form-control" value="@(profile?.FullName ?? "Aditya Verma")" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Father / Guardian Name</label>
                            <input class="form-control" value="@(profile?.FatherGuardianName ?? "Ramesh Verma")" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mother Name</label>
                            <input class="form-control" value="@(profile?.MotherName ?? "Sunita Verma")" readonly />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Masked Aadhaar Number</label>
                            <input class="form-control" value="@(profile?.MaskedAadhaar ?? "XXXX-XXXX-1234")" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Annual Family Income (INR)</label>
                            <input class="form-control" value="120000.00" name="AnnualIncome" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Household Category</label>
                            <select class="form-select" name="HouseholdCategoryId">
                                <option value="1">Below Poverty Line (BPL)</option>
                                <option value="2">Above Poverty Line (APL)</option>
                                <option value="3">Economically Weaker Section (EWS)</option>
                            </select>
                        </div>
                    </div>

                    <h6 class="fw-bold mt-4 mb-2 text-primary border-bottom pb-1">Correspondence Address</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label">Correspondence Address Line <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="AddressLine" value="@(addr?.AddressLine ?? "Shanti Nagar, Near Post Office")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">PIN Code <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="Pincode" value="@(addr?.Pincode ?? "492001")" maxlength="6" required />
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (currentStep == 2)
        {
            <!-- STEP 2: Current Academic Details -->
            <div class="gov-form-section">
                <div class="gov-section-header">
                    <i class="bi bi-mortarboard-fill me-2"></i> Step 2: Current Course &amp; Institute Enrollment
                </div>
                <div class="gov-section-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Enrolled Institute (College / University) <span class="required-asterisk">*</span></label>
                            <select class="form-select" id="InstituteId" name="InstituteId" required>
                                <option value="1">Government Engineering College, Raipur</option>
                                <option value="2">Pt. Ravishankar Shukla University, Raipur</option>
                                <option value="3">Government Polytechnic College, Durg</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Target Scholarship Scheme <span class="required-asterisk">*</span></label>
                            <select class="form-select" name="SchemeId" required>
                                <option value="1">Post Matric Scholarship for SC Students</option>
                                <option value="2">Post Matric Scholarship for ST Students</option>
                                <option value="3">Post Matric Scholarship for OBC Students</option>
                                <option value="4">State Higher Education Merit Scholarship</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Degree / Course Type <span class="required-asterisk">*</span></label>
                            <select class="form-select" id="CourseTypeId" name="CourseTypeId" required>
                                <option value="4">Professional Under-Graduate Degree</option>
                                <option value="5">General / Non-Professional Degree</option>
                                <option value="2">ITI / Polytechnic Diploma</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Course <span class="required-asterisk">*</span></label>
                            <select class="form-select" id="CourseId" name="CourseId" required>
                                <option value="1">Bachelor of Technology (B.Tech)</option>
                                <option value="2">Bachelor of Science (B.Sc)</option>
                                <option value="3">Bachelor of Computer Applications (BCA)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Branch / Specialization <span class="required-asterisk">*</span></label>
                            <select class="form-select" id="BranchId" name="BranchId" required>
                                <option value="1">Computer Science &amp; Engineering</option>
                                <option value="2">Mechanical Engineering</option>
                                <option value="3">Civil Engineering</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Admission Date <span class="required-asterisk">*</span></label>
                            <input class="form-control" type="date" name="AdmissionDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">College Enrollment Number <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="EnrollmentNumber" placeholder="e.g. ENR2024CS045" value="ENR2024CS045" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Course Year <span class="required-asterisk">*</span></label>
                            <select class="form-select" name="CourseYear">
                                <option value="1">1st Year</option>
                                <option value="2">2nd Year</option>
                                <option value="3">3rd Year</option>
                                <option value="4">4th Year</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Admission Mode / Quota <span class="required-asterisk">*</span></label>
                            <select class="form-select" name="AdmissionTypeId">
                                <option value="1">State / Central Merit Entrance</option>
                                <option value="2">Management Quota</option>
                                <option value="4">Spot Admission</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mode of Study <span class="required-asterisk">*</span></label>
                            <select class="form-select" name="StudyModeId">
                                <option value="1">Regular / Full-Time</option>
                                <option value="2">Distance Learning</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Hosteller / Day Scholar? <span class="required-asterisk">*</span></label>
                            <select class="form-select" name="IsHosteller">
                                <option value="false">Day Scholar</option>
                                <option value="true">Hosteller</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (currentStep == 3)
        {
            <!-- STEP 3: Previous Qualifications -->
            <div class="gov-form-section">
                <div class="gov-section-header">
                    <i class="bi bi-award me-2"></i> Step 3: Class 10th &amp; Previous Qualifying Examination
                </div>
                <div class="gov-section-body">
                    <h6 class="fw-bold text-primary border-bottom pb-1 mb-3">Class 10th (Secondary) Details</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">10th Roll Number <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="TenthRollNumber" placeholder="Roll Number" value="10245678" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Passing Year <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="TenthPassingYear" value="2022" type="number" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Secondary Board <span class="required-asterisk">*</span></label>
                            <select class="form-select" name="TenthBoardId">
                                <option value="1">CGBSE (Chhattisgarh Board)</option>
                                <option value="2">CBSE</option>
                                <option value="3">ICSE</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Percentage (%) <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="TenthPercentage" value="84.50" type="number" step="0.01" required />
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary border-bottom pb-1 mt-4 mb-3">Previous Qualifying Examination (12th / Diploma / Degree)</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Previous Course <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="PreviousInstituteName" value="Govt Higher Secondary School" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Previous Exam Roll No <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="PreviousRollNumber" value="12289410" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Passing Year <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="PreviousPassingYear" value="2024" type="number" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Percentage (%) <span class="required-asterisk">*</span></label>
                            <input class="form-control" name="PreviousPercentage" value="81.20" type="number" step="0.01" required />
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (currentStep == 4)
        {
            <!-- STEP 4: Bank Details -->
            <div class="gov-form-section">
                <div class="gov-section-header">
                    <i class="bi bi-bank2 me-2"></i> Step 4: DBT Bank Account Details
                </div>
                <div class="gov-section-body">
                    <div class="alert alert-info py-2 small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Scholarship benefits are disbursed directly into student's Aadhaar-seeded bank account through Public Financial Management System (PFMS) Direct Benefit Transfer (DBT).
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Bank Name <span class="required-asterisk">*</span></label>
                            <select class="form-select" id="BankId" name="BankId" required>
                                <option value="1">State Bank of India</option>
                                <option value="2">Punjab National Bank</option>
                                <option value="3">Bank of Baroda</option>
                                <option value="4">Chhattisgarh Rajya Gramin Bank</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Branch &amp; IFSC Code <span class="required-asterisk">*</span></label>
                            <select class="form-select" id="BranchId" name="BranchId" required>
                                <option value="1">Main Branch, Raipur (SBIN0000461)</option>
                                <option value="2">Pandri Branch, Raipur (SBIN0007204)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Account Number <span class="required-asterisk">*</span></label>
                            <input class="form-control" id="AccountNumber" name="AccountNumber" placeholder="Enter Bank Account Number" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Confirm Account Number <span class="required-asterisk">*</span></label>
                            <input class="form-control" id="ConfirmAccountNumber" name="ConfirmAccountNumber" placeholder="Re-enter Bank Account Number" required />
                        </div>
                    </div>

                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="aadhaarSeededCheck" name="IsAadhaarSeeded" value="true" checked />
                        <label class="form-check-label fw-bold small" for="aadhaarSeededCheck">
                            My bank account is active and seeded with my Aadhaar number for DBT payment receipts.
                        </label>
                    </div>
                </div>
            </div>
        }
        else if (currentStep == 5)
        {
            <!-- STEP 5: Statutory Certificates -->
            <div class="gov-form-section">
                <div class="gov-section-header">
                    <i class="bi bi-file-earmark-check-fill me-2"></i> Step 5: Statutory e-District Certificates
                </div>
                <div class="gov-section-body">
                    <!-- Caste Certificate -->
                    <div class="card mb-3 border">
                        <div class="card-header bg-light fw-bold small">Caste Certificate (Jati Praman Patra)</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Online Generated? <span class="required-asterisk">*</span></label>
                                    <select class="form-select" name="IsOnlineCaste">
                                        <option value="true">Yes (Generated from e-District portal)</option>
                                        <option value="false">No (Manual / Offline)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Certificate / Application Ref No <span class="required-asterisk">*</span></label>
                                    <input class="form-control" name="CasteRefNo" placeholder="e.g. ED/CST/2023/10294" value="ED/CST/2023/10294" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Source Portal</label>
                                    <input class="form-control" value="Chhattisgarh e-District Portal" readonly />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Domicile Certificate -->
                    <div class="card mb-3 border">
                        <div class="card-header bg-light fw-bold small">Domicile Certificate (Niwas Praman Patra)</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Online Generated? <span class="required-asterisk">*</span></label>
                                    <select class="form-select" name="IsOnlineDomicile">
                                        <option value="true">Yes (Generated from e-District portal)</option>
                                        <option value="false">No (Manual / Offline)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Certificate / Application Ref No <span class="required-asterisk">*</span></label>
                                    <input class="form-control" name="DomicileRefNo" placeholder="e.g. ED/DOM/2023/8492" value="ED/DOM/2023/8492" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Source Portal</label>
                                    <input class="form-control" value="Chhattisgarh e-District Portal" readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Stepper Navigation Buttons -->
        <div class="d-flex justify-content-between align-items-center mt-4 mb-5">
            @if (currentStep > 1)
            {
                <a asp-action="Wizard" asp-route-step="@(currentStep - 1)" class="btn btn-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i>Previous Step
                </a>
            }
            else
            {
                <div></div>
            }

            <button type="submit" class="btn btn-primary px-4 fw-bold">
                @(currentStep == 5 ? "Proceed to Final Preview" : "Save & Continue Next Step") <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    </form>
</div>
