@{
    ViewData["Title"] = "District Welfare Officer Scrutiny Queue";
}

<div class="container-fluid my-3">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-primary mb-0"><i class="bi bi-shield-check me-2"></i>District Welfare Officer (DWO) Sanction Desk</h4>
            <small class="text-muted">Applications verified by institutes awaiting district grant sanction</small>
        </div>
        <div>
            <span class="badge bg-primary py-2 px-3"><i class="bi bi-geo-alt me-1"></i>District: Raipur</span>
        </div>
    </div>

    <!-- Application Queue Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-table me-2"></i>District Sanction Queue</h6>
            <button class="btn btn-success btn-sm fw-bold"><i class="bi bi-check-all me-1"></i>Bulk Sanction Selected</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 small">
                    <thead class="table-dark">
                        <tr>
                            <th><input type="checkbox" class="form-check-input" /></th>
                            <th>Application ID</th>
                            <th>Student ID</th>
                            <th>Applicant Name</th>
                            <th>Institute</th>
                            <th>Course</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="checkbox" class="form-check-input" /></td>
                            <td><strong class="text-primary">SCH20268492</strong></td>
                            <td>PMS20261002</td>
                            <td>Aditya Verma</td>
                            <td>Govt Engineering College, Raipur</td>
                            <td>B.Tech (CSE)</td>
                            <td>SC</td>
                            <td><span class="badge bg-info text-dark"><i class="bi bi-check2 me-1"></i>INSTITUTE APPROVED</span></td>
                            <td class="text-center">
                                <a asp-action="Review" asp-route-id="1" asp-route-level="DISTRICT" class="btn btn-primary btn-sm">
                                    <i class="bi bi-shield-check me-1"></i>Sanction / Scrutinize
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
