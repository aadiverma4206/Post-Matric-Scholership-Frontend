@{
    ViewData["Title"] = "District Welfare Officer Scrutiny Queue";
    var queue = (Scholarship.Web.ViewModels.PagedResultViewModel<Scholarship.Web.ViewModels.ApplicationSummaryViewModel>?)ViewBag.Queue;
}

<div class="container-fluid my-3">
    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <div>
            <h4 class="fw-bold text-primary mb-0"><i class="bi bi-shield-check me-2"></i>District Welfare Officer (DWO) Sanction Desk</h4>
            <small class="text-muted">Applications verified by institutes awaiting district grant sanction</small>
        </div>
        <div>
            <span class="badge bg-primary py-2 px-3"><i class="bi bi-geo-alt me-1"></i>District Sanction Desk</span>
        </div>
    </div>

    <!-- Application Queue Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-secondary"><i class="bi bi-table me-2"></i>District Sanction Queue</h6>
            <button class="btn btn-success btn-sm fw-bold"><i class="bi bi-check-all me-1"></i>Bulk Sanction Selected</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0 small">
                    <thead class="table-dark">
                        <tr>
                            <th><input type="checkbox" class="form-check-input" /></th>
                            <th>Application ID</th>
                            <th>Student ID</th>
                            <th>Applicant Name</th>
                            <th>Institute</th>
                            <th>Course</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (queue?.Items != null && queue.Items.Any())
                        {
                            foreach (var item in queue.Items)
                            {
                                <tr>
                                    <td><input type="checkbox" class="form-check-input" value="@item.ApplicationId" /></td>
                                    <td><strong class="text-primary">@item.ApplicationNumber</strong></td>
                                    <td>@(item.StudentCode ?? "-")</td>
                                    <td class="fw-bold">@(item.FullName ?? item.StudentName ?? "-")</td>
                                    <td>@(item.InstituteName ?? "-")</td>
                                    <td>@(item.CurrentCourse ?? item.CourseName ?? "-")</td>
                                    <td>@(item.Category ?? "-")</td>
                                    <td><span class="badge bg-info text-dark"><i class="bi bi-check2 me-1"></i>@(item.StatusName ?? item.StatusCode ?? "PENDING")</span></td>
                                    <td class="text-center">
                                        <a asp-action="Review" asp-route-id="@item.ApplicationId" asp-route-level="DISTRICT" class="btn btn-primary btn-sm">
                                            <i class="bi bi-shield-check me-1"></i>Sanction / Scrutinize
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No applications found in the district sanction queue.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
