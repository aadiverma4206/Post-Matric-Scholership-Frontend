@model Scholarship.Web.ViewModels.AdminStudentDetailsViewModel

<div class="row g-4">
    <!-- Top Highlight Banner -->
    <div class="col-12">
        <div class="p-3 bg-light rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 54px; height: 54px;">
                    @(Model.FirstName.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "S")
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">@Model.FullName</h5>
                    <div class="text-muted small">
                        Student ID: <span class="badge bg-primary font-monospace fs-6">@Model.StudentCode</span>
                        <span class="ms-2">Registered: @Model.RegistrationDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>
            <div>
                @{
                    string statusBadge = Model.ApplicationStatusCode switch
                    {
                        "APPROVED" => "bg-success text-white",
                        "REJECTED" => "bg-danger text-white",
                        "INSTITUTE_VERIFICATION" => "bg-warning text-dark",
                        "DISTRICT_VERIFICATION" => "bg-primary text-white",
                        "SUBMITTED" or "LOCKED" => "bg-info text-dark",
                        "PAID" => "bg-success-subtle text-success-emphasis border border-success fw-bold",
                        _ => "bg-secondary-subtle text-dark border"
                    };
                }
                <div class="text-end">
                    <span class="badge @statusBadge fs-6 px-3 py-1">
                        @(Model.ApplicationStatusName ?? "No Application Submitted")
                    </span>
                    @if (!string.IsNullOrEmpty(Model.ApplicationNumber))
                    {
                        <div class="small text-muted font-monospace mt-1">
                            App No: @Model.ApplicationNumber
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Section 1: Basic & Identity -->
    <div class="col-md-6">
        <div class="card h-100 border shadow-none rounded-3">
            <div class="card-header bg-white py-2 fw-bold text-dark border-bottom small text-uppercase">
                <i class="bi bi-person-vcard text-primary me-2"></i>1. व्यक्तिगत पहचान | Personal &amp; Identity
            </div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless mb-0 small">
                    <tr>
                        <td class="text-muted" style="width: 40%;">जन्मतिथि | Date of Birth:</td>
                        <td class="fw-semibold">@Model.DateOfBirth.ToString("dd-MM-yyyy")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">लिंग एवं वर्ग | Gender &amp; Category:</td>
                        <td>
                            <span class="badge bg-light text-dark border me-1">@Model.GenderName</span>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">@Model.CategoryName</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">धर्म | Religion:</td>
                        <td class="fw-semibold">@Model.ReligionName</td>
                    </tr>
                    <tr>
                        <td class="text-muted">आधार स्थिति | Aadhaar:</td>
                        <td>
                            <span class="font-monospace fw-bold text-dark">@Model.MaskedAadhaar</span>
                            <span class="badge @(Model.AadhaarVerificationStatus == "VERIFIED" ? "bg-success" : "bg-warning text-dark") ms-1 small">
                                @Model.AadhaarVerificationStatus
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">संपर्क | Contact:</td>
                        <td>
                            <div><i class="bi bi-telephone text-primary me-1"></i>@Model.MaskedMobile</div>
                            <div><i class="bi bi-envelope text-info me-1"></i>@Model.MaskedEmail</div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Section 2: Family & Socio-Economic -->
    <div class="col-md-6">
        <div class="card h-100 border shadow-none rounded-3">
            <div class="card-header bg-white py-2 fw-bold text-dark border-bottom small text-uppercase">
                <i class="bi bi-people text-primary me-2"></i>2. पारिवारिक एवं आर्थिक स्थिति | Family &amp; Income
            </div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless mb-0 small">
                    <tr>
                        <td class="text-muted" style="width: 40%;">पिता/अभिभावक | Father:</td>
                        <td class="fw-semibold">@(string.IsNullOrEmpty(Model.FatherGuardianName) ? "Not Provided" : Model.FatherGuardianName)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">माता का नाम | Mother:</td>
                        <td class="fw-semibold">@(string.IsNullOrEmpty(Model.MotherName) ? "Not Provided" : Model.MotherName)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">वार्षिक आय | Annual Income:</td>
                        <td class="fw-bold text-success fs-6">
                            ₹@Model.AnnualIncome.ToString("N2")
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">आर्थिक श्रेणी | Category:</td>
                        <td>
                            <span class="badge bg-secondary-subtle text-dark">
                                @(Model.HouseholdCategory ?? "General / Unspecified")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">विशेष स्थिति | Special Status:</td>
                        <td>
                            @if (Model.IsOrphan) { <span class="badge bg-danger me-1">Orphan</span> }
                            @if (Model.IsDifferentlyAbled) { <span class="badge bg-warning text-dark me-1">Divyangjan</span> }
                            @if (!Model.IsOrphan && !Model.IsDifferentlyAbled) { <span class="text-muted">None</span> }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Section 3: Address Details -->
    <div class="col-md-6">
        <div class="card h-100 border shadow-none rounded-3">
            <div class="card-header bg-white py-2 fw-bold text-dark border-bottom small text-uppercase">
                <i class="bi bi-geo-alt text-primary me-2"></i>3. स्थायी पता | Permanent Address
            </div>
            <div class="card-body p-3 small">
                <div class="fw-semibold text-dark mb-1">
                    <i class="bi bi-house-door text-secondary me-1"></i>@(Model.PermanentAddressLine ?? "Address on file")
                </div>
                <div class="text-muted">
                    <span>जिला | District: <strong>@(Model.PermanentDistrict ?? "Raipur")</strong></span> | 
                    <span>पिनकोड | PIN: <strong>@(Model.PermanentPincode ?? "")</strong></span>
                </div>
                <div class="text-muted mt-1">
                    <span>ब्लॉक: @(Model.PermanentBlock ?? "N/A")</span> | 
                    <span>विधानसभा: @(Model.PermanentVidhansabha ?? "N/A")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Current Academic & Bank DBT -->
    <div class="col-md-6">
        <div class="card h-100 border shadow-none rounded-3">
            <div class="card-header bg-white py-2 fw-bold text-dark border-bottom small text-uppercase">
                <i class="bi bi-mortarboard text-primary me-2"></i>4. शैक्षणिक एवं बैंक डीबीटी | Academic &amp; Bank
            </div>
            <div class="card-body p-3 small">
                @if (!string.IsNullOrEmpty(Model.InstituteName))
                {
                    <div class="fw-bold text-dark text-truncate" title="@Model.InstituteName">
                        <i class="bi bi-building text-info me-1"></i>@Model.InstituteName
                    </div>
                    <div class="text-muted small mb-2">
                        Course: <strong>@Model.CourseName</strong> @(string.IsNullOrEmpty(Model.BranchName) ? "" : $"({Model.BranchName})") | Year @Model.CourseYear
                    </div>
                }
                else
                {
                    <div class="text-muted fst-italic mb-2">No academic record linked yet.</div>
                }

                <div class="border-top pt-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <i class="bi bi-bank text-primary me-1"></i>
                            <strong>@(Model.BankName ?? "Bank on file")</strong> (@(Model.IFSCCode ?? "IFSC"))
                            <div class="font-monospace text-muted">A/c: @(Model.MaskedAccountNumber ?? "XXXXXXXX")</div>
                        </div>
                        <div>
                            @if (Model.IsAadhaarSeeded)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">
                                    <i class="bi bi-check2-circle"></i> Aadhaar Seeded
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning">
                                    <i class="bi bi-exclamation-circle"></i> Seed Pending
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
