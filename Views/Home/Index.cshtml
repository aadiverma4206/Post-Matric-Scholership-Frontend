                <i class="bi bi-clock-history"></i>
            </div>
            <div class="fw-bold mb-1">Track Status</div>
            <small class="text-muted">Check real-time application scrutiny status</small>
        </a>
    </div>
</div>

<!-- =========================================================================
     5. 4-STEP APPLICATION PROCEDURE
     ========================================================================= -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: var(--gov-radius-md);">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-primary">
            <i class="bi bi-diagram-3-fill me-2"></i>How to Apply: 4-Step Seamless e-Scholarship Process
        </h5>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-none d-sm-inline">
            Step-by-Step Guide
        </span>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 text-center">
            <div class="col-lg-3 col-sm-6">
                <div class="step-box-item">
                    <div class="step-circle bg-primary text-white mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.15rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">1</div>
                    <h6 class="fw-bold text-dark mb-1">Online Registration</h6>
                    <p class="small text-muted mb-0">Fill basic details, 10th roll number, parents' info &amp; receive permanent 11-digit User ID.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="step-box-item">
                    <div class="step-circle bg-info text-white mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.15rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">2</div>
                    <h6 class="fw-bold text-dark mb-1">Fill Application Form</h6>
                    <p class="small text-muted mb-0">Provide current course, college enrollment, caste/income certificate and bank details.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="step-box-item">
                    <div class="step-circle bg-warning text-dark mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.15rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">3</div>
                    <h6 class="fw-bold text-dark mb-1">OTP Lock &amp; Scrutiny</h6>
                    <p class="small text-muted mb-0">Verify via Aadhaar OTP and lock form. College &amp; District officials conduct scrutiny.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="step-box-item">
                    <div class="step-circle bg-success text-white mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.15rem; display: flex; align-items: center; justify-content: center; border-radius: 50%;">4</div>
                    <h6 class="fw-bold text-dark mb-1">DBT Fund Disbursal</h6>
                    <p class="small text-muted mb-0">Scholarship amount credited directly to your Aadhaar-seeded active bank account.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     6. MAJOR POST-MATRIC SCHEMES (ST / SC / OBC)
     ========================================================================= -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
