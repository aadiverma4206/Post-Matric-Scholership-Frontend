            <small class="text-muted">First-time student sign up for AY 2025-26</small>
        </a>
    </div>
    <div class="col-md-3 col-6">
        <a asp-controller="Account" asp-action="Login" class="quick-action-tile">
            <div class="quick-action-icon bg-success-subtle text-success">
                <i class="bi bi-box-arrow-in-right"></i>
            </div>
            <div class="fw-bold mb-1">Student Login</div>
            <small class="text-muted">Login with 11-digit ID and password</small>
        </a>
    </div>
    <div class="col-md-3 col-6">
        <a asp-controller="Account" asp-action="ForgotUserId" class="quick-action-tile">
            <div class="quick-action-icon bg-warning-subtle text-warning-emphasis">
                <i class="bi bi-search"></i>
            </div>
            <div class="fw-bold mb-1">Search User ID</div>
            <small class="text-muted">Find permanent ID via 10th Roll Number</small>
        </a>
    </div>
    <div class="col-md-3 col-6">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Application/Status" class="quick-action-tile">
