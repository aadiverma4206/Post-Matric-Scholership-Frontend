                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Annual Family Income:</strong> Up to ₹ 2.50 Lakh</li>
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Coverage:</strong> Tuition Fee, Non-refundable Fee &amp; Maintenance</li>
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Courses:</strong> Diploma, Professional, UG, PG, Doctorate</li>
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Disbursement:</strong> 100% Aadhaar DBT to Bank Account</li>
                    </ul>
                </div>
                <div class="p-3 bg-light border-top text-center">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm w-100 fw-bold shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Apply for ST Scheme
                    </a>
                </div>
            </div>
        </div>

        <!-- SC Scheme -->
        <div class="col-lg-4 col-md-6">
            <div class="scheme-card-box">
                <div class="p-3 text-white fw-bold d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #0f766e, #059669);">
                    <div>
                        <i class="bi bi-mortarboard-fill me-2 fs-5"></i>
                        <span>Post Matric (SC)</span>
                    </div>
                    <span class="badge bg-light text-success">Scheduled Caste</span>
                </div>
                <div class="p-4 flex-grow-1">
                    <p class="small text-muted mb-3">
                        Centrally Sponsored Scheme implemented with Chhattisgarh Government empowering Scheduled Caste students to complete post-matriculation courses.
                    </p>
                    <ul class="small list-unstyled d-flex flex-column gap-2 text-secondary mb-0">
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Annual Family Income:</strong> Up to ₹ 2.50 Lakh</li>
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Coverage:</strong> Academic allowance, Tuition &amp; Exam fees</li>
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Courses:</strong> Technical, Medical, Engineering &amp; General</li>
                        <li><i class="bi bi-check2-circle text-success me-2 fw-bold"></i><strong>Disbursement:</strong> 100% Aadhaar DBT to Bank Account</li>
                    </ul>
                </div>
                <div class="p-3 bg-light border-top text-center">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-sm w-100 fw-bold shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Apply for SC Scheme
                    </a>
                </div>
            </div>
        </div>

        <!-- OBC Scheme -->
        <div class="col-lg-4 col-md-12">
            <div class="scheme-card-box">
                <div class="p-3 text-white fw-bold d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
                    <div>
                        <i class="bi bi-mortarboard-fill me-2 fs-5"></i>
                        <span>Post Matric (OBC)</span>
                    </div>
                    <span class="badge bg-light text-warning-emphasis">Other Backward Classes</span>
