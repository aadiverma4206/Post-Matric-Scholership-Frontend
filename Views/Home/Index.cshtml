                        <i class="bi bi-shield-check me-1"></i> 100% DBT Aadhaar Seeded
                    </span>
                </div>
            </div>

            <!-- Right: Hon'ble Chief Minister of Chhattisgarh -->
            <div class="col-lg-4 col-md-6">
                <div class="dignitary-card">
                    <div class="dignitary-avatar-wrap">
                        <img src="~/images/cg-cm.png" alt="Shri Vishnu Deo Sai - Chief Minister of Chhattisgarh" class="dignitary-avatar" />
                    </div>
                    <div class="dignitary-info">
                        <span class="dignitary-badge dignitary-badge-cg">
                            <i class="bi bi-geo-alt-fill text-primary me-1"></i> Chhattisgarh Shasan
                        </span>
                        <div class="dignitary-name">श्री विष्णु देव साय</div>
                        <div class="dignitary-title">Hon'ble Chief Minister of Chhattisgarh</div>
                        <p class="dignitary-quote">
                            "सशक्त युवा, समृद्ध छत्तीसगढ़ — हर पात्र विद्यार्थी तक समय पर छात्रवृत्ति पहुंचाना हमारा संकल्प।"
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     2. HERO BANNER SECTION (Academic Year 2025-26 Live)
     ========================================================================= -->
<div class="card border-0 shadow-sm overflow-hidden mb-4" style="background: linear-gradient(135deg, #07254a 0%, #0d386c 55%, #0284c7 100%); border-radius: var(--gov-radius-lg); position: relative;">
    <div class="p-4 p-md-5 text-white" style="position: relative; z-index: 2;">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.25); font-size: 0.85rem;">
                    <span class="badge bg-warning text-dark fw-bold badge-live-pulse">
                        <i class="bi bi-broadcast"></i> LIVE
                    </span>
                    <span>Academic Year 2025-26 Applications Now Active</span>
                </div>
                <h1 class="display-6 fw-bold mb-2 text-white">
                    Post Matric Scholarship Portal
                </h1>
                <h2 class="h5 fw-normal text-info-emphasis mb-3 text-white-50">
                    ऑनलाइन पोस्ट मैट्रिक छात्रवृत्ति पोर्टल | Chhattisgarh State e-Scholarship Automation
                </h2>
                <p class="lead fs-6 text-light opacity-90 mb-4 lh-base" style="max-width: 720px;">
                    An integrated, transparent, paperless e-governance platform for online application, institutional scrutiny, district approval, and Direct Benefit Transfer (DBT) of post-matric scholarships for eligible ST, SC, and OBC students in higher education.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-warning fw-bold px-4 py-2 shadow">
                        <i class="bi bi-person-plus-fill me-2"></i>New Student Registration
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light fw-bold px-4 py-2 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2 text-primary"></i>Student Login
                    </a>
                    <a asp-controller="Account" asp-action="ForgotUserId" class="btn btn-outline-light fw-semibold px-3 py-2">
                        <i class="bi bi-search me-1"></i>Search 11-Digit User ID
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <div class="p-4 rounded-4" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px);">
                    <div class="gov-emblem-badge mx-auto mb-3" style="width: 80px; height: 80px;">
                        <img src="~/images/cg-emblem.png" alt="Emblem of Chhattisgarh" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                    <h6 class="fw-bold text-warning mb-1">ST &amp; SC Development Department</h6>
                    <p class="small text-light opacity-75 mb-3">Government of Chhattisgarh</p>
                    <div class="badge bg-success py-2 px-3 w-100 fs-6">
                        <i class="bi bi-shield-check me-1"></i> 100% Aadhaar NPCI Seeded DBT
                    </div>
                    <div class="mt-3 text-start small text-light opacity-85 border-top border-white border-opacity-25 pt-2">
                        <div><i class="bi bi-check-circle-fill text-warning me-1"></i> Zero Physical Paperwork</div>
                        <div><i class="bi bi-check-circle-fill text-warning me-1"></i> Direct Bank Account Transfer</div>
                        <div><i class="bi bi-check-circle-fill text-warning me-1"></i> Real-time SMS &amp; Portal Tracking</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

