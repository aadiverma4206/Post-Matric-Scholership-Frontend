                <i class="bi bi-award-fill text-warning me-2"></i>Post Matric Scholarship Schemes (AY 2025-26)
            </h4>
            <small class="text-muted">Eligible categories for Higher Education in Government and Recognized Institutes</small>
        </div>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm fw-bold">
            View All Schemes <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        <!-- ST Scheme -->
        <div class="col-lg-4 col-md-6">
            <div class="scheme-card-box">
