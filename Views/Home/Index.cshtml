    <!-- Mandatory Student Advisory Notice -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100 bg-warning-subtle border-start border-warning border-4" style="border-radius: var(--gov-radius-md);">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-3"></i>
                    <h5 class="fw-bold text-dark mb-0">Mandatory Student Advisory</h5>
                </div>
                <div class="small text-dark lh-base">
                    <div class="mb-3 p-2 bg-white rounded border border-warning-subtle">
                        <strong class="text-danger"><i class="bi bi-bank2 me-1"></i> Aadhaar NPCI Seeding is Compulsory:</strong>
                        <p class="mb-0 text-secondary mt-1">
                            Scholarship funds are disbursed solely via Aadhaar Payment Bridge (APB). Your bank account MUST be active and seeded with NPCI.
                        </p>
                    </div>
                    <ul class="ps-3 mb-0 d-flex flex-column gap-2 text-secondary">
                        <li>
                            <strong>Name &amp; DOB Match:</strong> Details must match exactly with your 10th Class mark sheet and Aadhaar card.
                        </li>
                        <li>
                            <strong>Valid Digital Certificates:</strong> Only e-District online issued caste &amp; income certificates with barcode/QR are accepted.
                        </li>
                        <li>
                            <strong>Mandatory OTP Lock:</strong> After entering all details, you must lock the application using Aadhaar OTP. Unlocked forms will not be scrutinized.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

