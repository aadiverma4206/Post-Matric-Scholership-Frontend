@model Scholarship.Web.ViewModels.BankAccountViewModel
@{
    ViewData["Title"] = "Student Bank Details";
    Layout = "_Layout";
    var bank = (Scholarship.Web.ViewModels.BankAccountViewModel?)ViewBag.BankAccount;
    var banks = (List<Scholarship.Web.ViewModels.LookupItemViewModel>)(ViewBag.Banks ?? new List<Scholarship.Web.ViewModels.LookupItemViewModel>());
}

<div class="container my-3">
    <!-- Mandatory Instructions matching PDF Page 19 -->
    <div class="alert alert-info py-2 small shadow-sm mb-4">
        <strong>Note :</strong>
        1) Fields marked with (<span class="text-danger fw-bold">*</span>) are mandatory. 
        2) Upload Scanned copy of your Bank Passbook's front Page where Account No. &amp; IFSC code is clearly visible. 
        3) Please provide active bank account number which is seeded to your Aadhaar Number as only Aadhaar based DBT payment will be done. 
        4) To seed your bank account with Aadhaar, please visit your branch and submit "bank consent form for receiving DBT". 
        5) IFSC Code 'SBIN0RRCHGB' of CHHATTISGARH RAJYA GRAMIN BANK is now invalid; use updated branch IFSC code.
    </div>

    <form asp-action="Index" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="gov-form-section mb-4">
            <div class="gov-section-header">
                <i class="bi bi-bank2 me-2"></i> Student Bank Account &amp; DBT Seeding
            </div>
            <div class="gov-section-body">
                <!-- IFSC and Branch Auto-Detection (PDF Page 19) -->
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">IFSC Code <span class="required-asterisk">*</span></label>
                        <div class="input-group">
                            <input class="form-control text-uppercase" id="IfscCodeInput" value="SBIN0002852" placeholder="e.g. SBIN0002852" required />
                            <button class="btn btn-outline-primary btn-sm" type="button" id="btnSearchIfsc"><i class="bi bi-search"></i></button>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Bank Name</label>
                        <input class="form-control bg-light fw-bold" id="BankNameDisplay" value="STATE BANK OF INDIA" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Branch Name <span class="required-asterisk">*</span></label>
                        <input class="form-control bg-light" id="BranchNameDisplay" value="GCET, RAIPUR" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Branch Address</label>
                        <input class="form-control bg-light small" id="BranchAddressDisplay" value="GOVT COLLEGE OF ENGG CAMPUS, RAIPUR" readonly />
                    </div>
                </div>

                <!-- Account Number & Double-Entry Confirmation (PDF Page 20) -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Account Number <span class="required-asterisk">*</span></label>
                        <input class="form-control" name="AccountNumber" id="AccountNumber" value="34871092841" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Confirm Account Number <span class="required-asterisk">*</span></label>
                        <input class="form-control" name="ConfirmAccountNumber" id="ConfirmAccountNumber" value="34871092841" required />
                    </div>
                </div>

                <!-- Passbook Scan Upload (PDF Page 20) -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Passbook Scan Copy (PDF / JPG, Max 120KB) <span class="required-asterisk">*</span></label>
                        <input type="file" class="form-control" name="passbookFile" accept=".pdf,.jpg,.jpeg" />
                        <div class="form-text small text-muted"><i class="bi bi-info-circle me-1"></i>Front page showing Account Number and IFSC clearly. Max 120KB.</div>
                        @if (bank?.PassbookDocumentId != null && bank.PassbookDocumentId > 0)
                        {
                            <div class="mt-2">
                                <span class="badge bg-success mb-1"><i class="bi bi-check-circle me-1"></i>Passbook Scan Uploaded</span>
                                <a href="/Document/Download/@bank.PassbookDocumentId" target="_blank" class="btn btn-link btn-sm p-0 ms-2 text-decoration-none">
                                    <i class="bi bi-eye me-1"></i>View Uploaded Passbook
                                </a>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Select Aadhaar Seeded Bank <span class="required-asterisk">*</span></label>
                        <select class="form-select" name="BankId" required>
                            <option value="1" selected>STATE BANK OF INDIA</option>
                            <option value="2">PUNJAB NATIONAL BANK</option>
                            <option value="3">BANK OF BARODA</option>
                            <option value="4">CHHATTISGARH RAJYA GRAMIN BANK</option>
                            <option value="5">HDFC BANK LTD</option>
                            <option value="6">BANK OF INDIA</option>
                            <option value="7">CANARA BANK</option>
                            <option value="8">UNION BANK OF INDIA</option>
                            <option value="9">AXIS BANK</option>
                            <option value="10">ICICI BANK LTD</option>
                        </select>
                        <input type="hidden" name="BranchId" value="1" />
                    </div>
                </div>

                <!-- Mandatory Hindi Declaration Checkbox (PDF Page 20) -->
                <div class="p-3 bg-light rounded border">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsAadhaarSeeded" value="true" checked id="dbtDeclaration" required />
                        <label class="form-check-label fw-bold text-dark small" for="dbtDeclaration">
                            मैं सत्यापित करता / करती हूँ कि मेरा बैंक अकाउंट सक्रिय है एवं मेरे द्वारा प्रदान किया गया बैंक खाता विवरण मेरे आधार नंबर के साथ सीडेड है |
                            <br />
                            <span class="text-muted fw-normal">(I certify that my bank account is active and seeded with my Aadhaar number for DBT transfers.)</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between my-4">
            <a asp-controller="Academic" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Academic Details
            </a>
            <button type="submit" class="btn btn-success fw-bold px-4 py-2">
                <i class="bi bi-check-circle-fill me-1"></i> Save Bank Details
            </button>
        </div>
    </form>
</div>
